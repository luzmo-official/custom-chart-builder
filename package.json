{
  "name": "luzmo-custom-chart-builder",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:angular": "ng serve -o --proxy-config proxy.conf.json",
    "start:bundle-server": "node server.js",
    "start:watcher": "node scripts/watch.js",
    "start": "concurrently \"npm run start:angular\" \"npm run start:bundle-server\" \"npm run start:watcher\" --kill-others --names \"ANGULAR,BUNDLE,WATCHER\" --prefix-colors \"blue,green,yellow\" --prefix \"[{name}]\"",
    "build": "cd projects/custom-chart && npm run build && cd ../.. && node scripts/copy-assets.js && npm run archive",
    "archive": "node scripts/archive-bundle.js",
    "validate": "node scripts/validate-manifest.js",
    "charts": "node scripts/charts.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "cd projects/custom-chart && npm install"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/localize": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@lit-labs/signals": "^0.1.3",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@lit/localize": "^0.12.2",
    "@lit/task": "^1.0.3",
    "@luzmo/analytics-components-kit": "1.0.6",
    "@luzmo/dashboard-contents-types": "1.0.39",
    "@luzmo/icons": "^1.0.1-alpha.45",
    "@luzmo/lucero": "2.0.0",
    "@luzmo/ngx-analytics-components-kit": "1.0.6",
    "@luzmo/ngx-lucero": "2.0.0",
    "lit": "^3.3.2",
    "ngx-json-viewer": "^3.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "archiver": "^7.0.1",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "istanbul-lib-instrument": "^6.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
