{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/builder",
    "paths": {
      "@builder/*": ["./src/app/*"]
    }
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts", "src/**/*.ts", "../custom-chart/utils/types.utils.ts"],
  "exclude": [
    "src/**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
