{
  "extends": "../../tsconfig.spec.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "outDir": "../../out-tsc/spec",
    "paths": {
      "@builder/*": ["./src/app/*"]
    }
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "../custom-chart/utils/types.utils.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
