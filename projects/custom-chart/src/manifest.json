{
  "context": {
    "description": "Vertical column chart with one column per category, optionally split by a legend. Use for comparing a value across a handful of categories.",
    "synonyms": ["column chart", "vertical bar"]
  },
  "slots": [
    {
      "name": "category",
      "context": { "description": "One column per value along the horizontal axis. Use a hierarchy or datetime column for the categories." },
      "rotate": false,
      "label": "Category",
      "type": "categorical",
      "options": {
        "isBinningDisabled": true,
        "areDatetimeOptionsEnabled": true
      },
      "isRequired": true,
      "acceptableColumnTypes": ["hierarchy", "datetime"]
    },
    {
      "name": "measure",
      "context": { "description": "The numeric value shown as column height. Apply the aggregation requested by the user." },
      "rotate": true,
      "label": "Value",
      "type": "numeric",
      "options": {
        "isAggregationDisabled": false
      },
      "isRequired": true,
      "acceptableColumnTypes": ["numeric"],
      "canAcceptFormula": true
    },
    {
      "name": "legend",
      "context": { "description": "Optional grouping column to split each category into colored series." },
      "rotate": false,
      "label": "Legend",
      "type": "categorical",
      "options": {
        "isBinningDisabled": true
      },
      "isRequired": false,
      "acceptableColumnTypes": ["hierarchy", "datetime"]
    }
  ],
  "options": [
    {
      "key": "bars",
      "type": "group",
      "open": true,
      "children": [
        {
          "key": "bars.roundedCorners",
          "control": { "type": "slider", "default": 4, "min": 0, "max": 20, "step": 1 }
        },
        {
          "key": "bars.showValue",
          "control": { "type": "switch", "default": false }
        }
      ]
    }
  ],
  "translations": {
    "en": {
      "slots": {
        "category": { "label": "Category" },
        "measure": { "label": "Value" },
        "legend": { "label": "Legend" }
      },
      "options": {
        "groups": {
          "bars": { "label": "Bars" }
        },
        "bars.roundedCorners": { "label": "Rounded corners" },
        "bars.showValue": { "label": "Show value in bar" }
      }
    },
    "fr": {
      "slots": {
        "category": { "label": "Catégorie" },
        "measure": { "label": "Valeur" },
        "legend": { "label": "Légende" }
      },
      "options": {
        "groups": {
          "bars": { "label": "Barres" }
        },
        "bars.roundedCorners": { "label": "Coins arrondis" },
        "bars.showValue": { "label": "Afficher la valeur dans la barre" }
      }
    }
  }
}
